# Copiá este archivo como ".env" y completá con tus datos reales.

# Datos de tu proyecto de Supabase (Project Settings > API en tu dashboard)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-api-key-anon-publica

# Clave secreta de Flask para las cookies de sesión (login). Poné cualquier
# texto largo y random — por ejemplo, generalo así en una terminal Python:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=cambiar-esto-por-un-texto-random-largo

# Opcional: solo si querés usar el asistente de IA "Preguntale a ForgeFit".
# Conseguí tu clave en console.anthropic.com (requiere cuenta y créditos de API).
ANTHROPIC_API_KEY=tu-clave-de-anthropic
